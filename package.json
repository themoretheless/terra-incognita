{
  "name": "terra-incognita",
  "version": "0.3.0",
  "private": true,
  "description": "Карта путешественника с туманом войны: открытые области сохраняются навсегда",
  "type": "module",
  "scripts": {
    "start": "vite",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "eslint .",
    "format": "prettier --write src tests bench",
    "format:check": "prettier --check src tests bench",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "node bench/store-bench.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8765 --strictPort",
    "svet:update": "git submodule update --remote vendor/forma && npm install",
    "svet:build": "npm --prefix vendor/forma/packages/svet ci --no-audit --no-fund && npm --prefix vendor/forma/packages/svet run build:package",
    "postinstall": "npm run svet:build"
  },
  "devDependencies": {
    "@eslint/js": "9.12.0",
    "eslint": "9.12.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.11.0",
    "h3-js": "4.1.0",
    "playwright-core": "1.47.2",
    "prettier": "3.3.3",
    "svet-engine": "file:vendor/forma/packages/svet",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  }
}
